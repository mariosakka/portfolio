#!/usr/bin/env bash
# Fast local gate. CI is authoritative; this can be bypassed.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if ! command -v gitleaks >/dev/null; then
  echo "pre-push: gitleaks not found. Install it (winget install gitleaks / brew install gitleaks) and retry." >&2
  exit 1
fi
gitleaks git --no-banner --redact
python scripts/check_agent_instructions.py .
base=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || echo origin/main)
node scripts/check-test-sync.ts "$base"
npm run typecheck
npm run lint
npm test
